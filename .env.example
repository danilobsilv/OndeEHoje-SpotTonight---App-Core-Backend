# Compose reads this file; host-run Spring Boot requires exported environment variables.
DB_USERNAME=
DB_PASSWORD=
# Published PostgreSQL port for host development:
DB_PORT=5432
# Host-run Spring Boot only. Match this port to DB_PORT.
# Compose always supplies jdbc:postgresql://postgres:5432/spotnight to the backend.
DB_URL=jdbc:postgresql://localhost:5432/spotnight
# Compose defaults to local (Swagger enabled); use prod to disable API docs.
SPRING_PROFILES_ACTIVE=local
# Generate a random 32-byte key and Base64 encode it; never commit a real key.
JWT_SECRET=
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P30D
# Set false only for plain-HTTP local browser development. Production requires true.
AUTH_COOKIE_SECURE=true
